{
  "manifest_version": 3,
  "name": "DealScour Live Price Scourer",
  "version": "0.1.0",
  "description": "One-click background price scouring across Amazon, Flipkart, Blinkit, Swiggy Instamart, and Zepto for your DealScour shopping list.",
  "action": {},
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://*.amazon.in/*",
    "https://*.flipkart.com/*",
    "https://*.blinkit.com/*",
    "https://*.swiggy.com/*",
    "https://*.instamart.in/*",
    "https://*.zepto.com/*",
    "https://*.zeptonow.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["portal-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
