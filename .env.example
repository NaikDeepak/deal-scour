# DealScour configuration. Copy to .env and fill in. Never commit .env.
# BYOK (ADR-022): every deployment brings its own keys. Leave a key empty and that feature stays off.

# Core
DEALSCOUR_BASE_URL=http://localhost:8000
DEALSCOUR_DOMAIN=                # e.g. deals.example.com; Caddy gets HTTPS for it (deploy/README.md)
DEALSCOUR_SECRET_KEY=            # required: random 32+ bytes (python3 -c "import secrets; print(secrets.token_urlsafe(32))")
DEALSCOUR_OWNER_EMAIL=           # required: the first account; only this email can claim a fresh instance
DEALSCOUR_DEV_LOGIN=0            # 1 = print sign-in codes to the server log instead of emailing (local dev only!)
DEALSCOUR_DB_PATH=./data/dealscour.db
DEALSCOUR_DEFAULT_PINCODE=411018
DEALSCOUR_TIMEZONE=Asia/Kolkata

# Sign-in by email OTP (ADR-013): any SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Alerts (ADR-015)
TELEGRAM_BOT_TOKEN=              # from @BotFather; empty = Telegram off
TELEGRAM_CHAT_ID=                # owner chat id for deal radar alerts; empty = Telegram off
TELEGRAM_WEBHOOK_SECRET=
DEALSCOUR_QUIET_HOURS_START=23   # hold Telegram alerts from 23:00 until 07:00
DEALSCOUR_QUIET_HOURS_END=7
DEALSCOUR_DAILY_ALERT_CAP=10
VAPID_PUBLIC_KEY=                # Web Push; empty = push off
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional LLM list parsing (ADR-016): off unless a key is set
ANTHROPIC_API_KEY=
DEALSCOUR_LLM_MODEL=claude-haiku-5-5
DEALSCOUR_LLM_MONTHLY_CAP_USD=2

# Optional Gemini autofill for staples tracker: off unless a key is set
GEMINI_API_KEY=
DEALSCOUR_GEMINI_MODEL=gemini-3.8-flash
DEALSCOUR_LLM_MONTHLY_CAP_RUPEES=100

# Automatic prices for YOUR custom Amazon/Flipkart products (ADR-004): polite, low volume, off by default.
# Max 30 product pages per run, >= 10 s apart, sequential; pauses a site for 24 h after 3 failures.
# Blinkit / Zepto / Instamart block automated requests, so they stay manual.
DEALSCOUR_FETCHERS=0
DEALSCOUR_FETCH_INTERVAL_HOURS=6

# Optional Amazon Product Advertising API (ADR-004)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
